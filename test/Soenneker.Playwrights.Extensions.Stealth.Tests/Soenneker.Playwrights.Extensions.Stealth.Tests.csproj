<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <None Remove="appsettings.json" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Soenneker.Tests.Attributes.Local" Version="11.0.153" />
        <PackageReference Include="Soenneker.Playwrights.Installation" Version="4.0.232" />
        <PackageReference Include="Soenneker.Utils.Delay" Version="4.0.105" />
        <PackageReference Include="Soenneker.Utils.Test" Version="4.0.342" />
        <PackageReference Include="Soenneker.Tests.HostedUnit" Version="4.0.338" />
        <PackageReference Include="TUnit" Version="1.76.28" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Soenneker.Playwrights.Extensions.Stealth\Soenneker.Playwrights.Extensions.Stealth.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="appsettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="11.0.0-rc.3.26522.148" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0-rc.3.26522.148" />
    </ItemGroup>
